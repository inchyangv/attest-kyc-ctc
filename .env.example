# ── Development wallet ──
# Testnet only. Never put a mainnet key here.
DEPLOYER_PRIVATE_KEY="0x<64-hex>"
DEPLOYER_ADDRESS="0x..."
# Testnet deployment role custody. The deployer only pays contract-creation transactions; it is
# not granted an application or governance role. Production replaces raw keys with approved
# KMS/HSM or multisig workflows rather than copying these testnet variables.
GOVERNANCE_OWNER_PRIVATE_KEY=""
ASSET_OWNER_PRIVATE_KEY=""
SOURCE_ISSUER_ADDRESS=""
WORKER_PAYER_ADDRESS=""
# T-06 product decision. Current scope-v0 contracts accept only the explicit single-issuer mode;
# `independent-issuer-scoped` remains blocked until the incompatible scoped release exists.
PROOFMARK_ISSUER_MODE=""
# T-13 release roles. Addresses only; private keys belong in approved KMS/multisig workflows.
# The correction approver must differ from the proposing issuer. Asset roles must differ.
DENIAL_CORRECTION_APPROVER_ADDRESS=""
ASSET_RECOVERY_PROPOSER_ADDRESS=""
ASSET_RECOVERY_APPROVER_ADDRESS=""

# Hosted Sumsub verification (evidence candidate only; does not issue a mark).
# Optional fixed fictional lesson for /demo, independent of KYC_DEMO. Does not enable demo issuance.
SANCTIONS_TRAINING_ENABLED=0
# No demo fallback. Configure an approved identity/processing/retention policy first.
# Choose ONE environment's credentials; never reuse API, webhook, evidence or state keys.
SUMSUB_ENVIRONMENT=
SUMSUB_PROCESSING_RECIPIENT=
SUMSUB_EVIDENCE_HMAC_KEY=
SUMSUB_STATE_REDIS_REST_URL=
SUMSUB_STATE_REDIS_REST_TOKEN=
SUMSUB_STATE_KEY=
SUMSUB_STATE_TTL_SECONDS=
SUMSUB_STATE_NAMESPACE=proofmark
# Local Sandbox integration tests only. Production always requires Redis.
SUMSUB_STATE_MODE=
SUMSUB_LOCAL_TEST=0
SUMSUB_SANDBOX_TEST_MODE=0
SUMSUB_SANDBOX_APP_TOKEN=
SUMSUB_SANDBOX_SECRET_KEY=
SUMSUB_SANDBOX_WEBHOOK_SECRET=
SUMSUB_SANDBOX_LEVEL_NAME=
SUMSUB_PRODUCTION_APP_TOKEN=
SUMSUB_PRODUCTION_SECRET_KEY=
SUMSUB_PRODUCTION_WEBHOOK_SECRET=
SUMSUB_PRODUCTION_LEVEL_NAME=
# Optional bounded engineering limits, not approved legal retention or a risk SLA.
SUMSUB_SDK_TTL_SECONDS=600
SUMSUB_WEBHOOK_MAX_AGE_SECONDS=600

# ── Source chain: Ethereum Sepolia (chainKey 1 · chainId 11155111) ──
SOURCE_CHAIN_RPC_URL="https://ethereum-sepolia-rpc.publicnode.com"

# ── Verification hub: Creditcoin CC3 Testnet (chainId 102031) ──
CREDITCOIN_RPC_URL="https://rpc.cc3-testnet.creditcoin.network"
PROOF_BUILDER_URL="https://prover.cc3-testnet.creditcoin.network"
CHAININFO_PRECOMPILE="0x0000000000000000000000000000000000000fd3"
BLOCKPROVER_PRECOMPILE="0x0000000000000000000000000000000000000FD2"

# ── Worker: fill in after deployment (see deployments/cc3-testnet.json) ──
WORKER_PRIVATE_KEY=""             # Dedicated hub relay key; no deployer-key fallback
WORKER_SIGNER_ADDRESS=""          # Exact worker payer identity; must match before RPC use
SOURCE_CONTRACT_ADDRESS="0x..."   # Sepolia ComplianceSource
ASC_CONTRACT_ADDRESS="0x..."      # CC3 ProofmarkASC

# ── Worker tuning (defaults are sufficient) ──
WORKER_CONFIRMATIONS=4     # Reorg safety margin in blocks
WORKER_HUB_CONFIRMATIONS=6 # Canonical receipt depth before releasing the relay nonce
WORKER_SCAN_CHUNK=500      # Maximum eth_getLogs range
WORKER_POLL_MS=12000
WORKER_CONCURRENCY=8       # Prevent eight-minute attest waits from blocking one another
WORKER_MAX_ATTEMPTS=8
WORKER_STATE_PATH="state/worker.json"
WORKER_START_BLOCK=        # Required positive source deployment/replay start block; run worker:init-state once before first worker start
# Read-only worker monitor (docs/59). Explicit expected scope; no signing key or RPC required.
SOURCE_CHAIN_KEY=1
MONITOR_WORKER_HUB_CHAIN_ID=102031
MONITOR_WORKER_SIGNER_ADDRESS=
MONITOR_WORKER_JOB_SECONDS=
MONITOR_WORKER_ATTEMPTS=
# Optional live self-report at http://127.0.0.1:<port>/health; both settings or neither.
# Positive whole milliseconds; approve a threshold that covers polling/RPC/scan durations.
WORKER_HEALTH_PORT=
WORKER_HEALTH_MAX_SCAN_AGE_MS=
# T-17 composite read-only service monitor. All thresholds are explicit operator choices,
# not approved production SLA values. The monitor loads no worker private key and sends no alert.
MONITOR_WORKER_SERVICE_TIMEOUT_MS=
MONITOR_WORKER_SOURCE_MAX_BLOCK_LAG=
MONITOR_WORKER_SOURCE_MAX_HEAD_AGE_SECONDS=
MONITOR_WORKER_HUB_MAX_HEAD_AGE_SECONDS=
MONITOR_WORKER_HUB_MIN_BALANCE_WEI=
MONITOR_WORKER_HUB_MAX_GAS_PRICE_WEI=
MONITOR_WORKER_HUB_MAX_NONCE_BACKLOG=
# Only `record:worker:service` writes this redacted local evidence directory. An external
# scheduler/receiver is still required. The staging window cannot be set below seven days.
MONITOR_WORKER_EVIDENCE_DIR=
MONITOR_WORKER_RUN_INTERVAL_SECONDS=
MONITOR_WORKER_MISSED_AFTER_SECONDS=
MONITOR_WORKER_STAGING_SECONDS=604800
MONITOR_WORKER_STAGING_MIN_JOBS=

# ── Evidence pseudonymization key (required, no default) ──
# Names have low entropy, so unsalted hashes are vulnerable to dictionary attacks. Use an issuer-held HMAC key.
# This is pseudonymization, not anonymization: a key holder can test candidate values, preserving audit reproducibility.
# Generate with: openssl rand -hex 32
EVIDENCE_HMAC_KEY=""
EVIDENCE_KEY_ID="k1"
# Dedicated web-flow token key. Keep it independent from evidence/vault/journal/signing keys.
SERVER_TOKEN_KEY=""
SERVER_TOKEN_KEY_ID="token-k1"
# Optional bounded verification-only window for tokens sealed before a rotation. Set all or none;
# remove all three after the deadline to retire the previous key.
SERVER_TOKEN_PREVIOUS_KEY=""
SERVER_TOKEN_PREVIOUS_KEY_ID=""
SERVER_TOKEN_PREVIOUS_ACCEPT_UNTIL="" # Unix milliseconds
# Shared CLI/web ceiling based on a verified full GET, never filesystem mtime. Must be >0 and <=168.
# Seven days is a sandbox ceiling, NOT an approved production risk limit. Refresh at least daily.
SANCTIONS_MAX_AGE_HOURS=168
# Purpose-specific limits use the same snapshot but may be stricter for state-changing paths.
# These are sandbox engineering defaults, not an approved customer risk policy.
SANCTIONS_SCREEN_MAX_AGE_HOURS=168
SANCTIONS_ISSUANCE_MAX_AGE_HOURS=24
SANCTIONS_RESCREEN_MAX_AGE_HOURS=24
SANCTIONS_EPOCH_MAX_AGE_HOURS=24
# Optional coordinated rollout pin: every runtime must report this exact manifest snapshot ID.
SANCTIONS_EXPECTED_SNAPSHOT_ID=
# FATF statement recheck ceiling. The bundled observation is versioned independently from list downloads.
FATF_MAX_AGE_DAYS=120
# Required when KYC_DEMO is not 1. This is a validated proofmark-processing-policy-v1 data-flow
# manifest, not a legal opinion: use only actual customer/controller/vendor/location/retention,
# notice/rights, RRN authority, contract and legal-review evidence refs. Never invent approvals.
PROCESSING_POLICY_JSON=
# Required when KYC_DEMO is not 1. A validated proofmark-retention-policy-v1 must cover every
# outcome and storage/effect layer with an explicit trigger, deadline and credential disposition.
# References are not legal approval; do not invent them or use a universal five-year fallback.
RETENTION_POLICY_JSON=
# Epoch schema v2: lifetime anchored to scanned source cutoff, capped by the contracts at 24h.
EPOCH_VALID_HOURS=24
# Roster authorization v1: explicitly provision this role; publication never grants it.
# Dedicated Sepolia publisher key, never the deployer/issuance/rescreen key.
EPOCH_PUBLISHER_PRIVATE_KEY=""
EPOCH_PUBLISHER_ADDRESS=""  # Dry-run approval plans and --check-publication journal scope
EPOCH_PUBLICATION_JOURNAL_PATH="" # Required shared persistent path for this dedicated publisher
EPOCH_PUBLICATION_JOURNAL_KEY="" # Independent high-entropy secret, at least 32 characters; never log
EPOCH_SOURCE_WAIT_SECONDS="30" # 1..300; unresolved source tx requires --resume-publication
EPOCH_RECORD_DIR="" # Optional local publication evidence directory; defaults to deployments/
# JSON array of at least two approved, distinct durable directories. Complete content-addressed
# roster seeds are fsync'd here before a publication intent can be signed; final bundles follow
# source confirmation. Local paths alone are not independent hosting or an availability SLA.
EPOCH_BUNDLE_REPLICA_DIRS="[]"
# Set to the exact token only after wallet-linkable roster distribution destinations/rights are approved.
EPOCH_BUNDLE_DISCLOSURE_ACK=""
DEMO_EXPECTED_ISSUER="" # Independently approved issuer for exact frozen demo policy checks; no inference
DEMO_SOURCE_CODEHASH="" # Reviewed release runtime keccak256, not copied from the checked RPC
DEMO_ASC_CODEHASH=""
DEMO_REGISTRY_CODEHASH=""
EPOCH_HUB_CONFIRMATIONS="6" # Exact acceptance receipt depth, not merely latestEpoch reaching a number
EPOCH_HUB_FROM_BLOCK="" # --check-publication requires shell-exported inclusive start at/before carry; max 20000 blocks
EPOCH_APPROVALS_FILE=""     # Issuer-approved JSON plan; required for other issuers' leaves
# Full source replay: direct CREATE tx; otherwise read matching deployment.sourceDeployment.transactionHash.
# Never substitute a guessed block floor. The header RPC must be independently operated from
# SOURCE_CHAIN_RPC_URL; it supplies the finalized headers/receipt roots used to reject omissions.
SOURCE_DEPLOYMENT_TX=""
SOURCE_HEADER_RPC_URL="https://rpc.sepolia.org"
SOURCE_CONFIRMATIONS=12
SOURCE_SCAN_CHUNK=100
# Per-run work budgets. Without an authenticated checkpoint they cover the full deployment history.
SOURCE_SNAPSHOT_MAX_BLOCKS=20000
SOURCE_SNAPSHOT_MAX_RECEIPTS=200000
SOURCE_SNAPSHOT_CHECKPOINT_PATH="" # Optional encrypted incremental state; use one durable shared path
SOURCE_SNAPSHOT_CHECKPOINT_KEY="" # Independent secret (32+ chars); never log or commit
REGISTRY_CONTRACT_ADDRESS="0x..."
# Recording preflight margin, not a security-policy lifetime (24h remaining is impossible after relay).
EPOCH_MIN_REMAINING_SECONDS=3600

# Persistent encrypted evidence vault for non-demo issuance. Do not point this at an ephemeral
# serverless filesystem; run the web service on persistent encrypted storage or add a remote vault adapter.
EVIDENCE_VAULT_PATH="state/evidence-vault.enc"
RESCREEN_INTERVAL_HOURS=24
# Dedicated source-chain issuer key for rescreen revocations; do not share its nonce with other jobs.
RESCREEN_PRIVATE_KEY=""
RESCREEN_SIGNER_ADDRESS="" # Exact dedicated signer identity; must match the private key before RPC use
RESCREEN_CONFIRMATIONS=6
# Scheduled one-shot mode: `npm run rescreen -- --publish --scheduled`. The opaque ID and
# cadence are bound into a redacted durable run-state file; an external scheduler still invokes it.
RESCREEN_RUN_STATE_PATH="state/rescreen-run.json"
RESCREEN_SCHEDULE_ID="proofmark-rescreen-v1" # Assign a new opaque ID for a different deployment/run scope.
RESCREEN_SCHEDULE_INTERVAL_SECONDS=86400
MONITOR_RESCREEN_RUN_SECONDS=3600
# Read-only per-case source -> hub revocation check (docs/55). Use independently approved
# runtime hashes, not hashes copied from the RPC being checked. This command uses no signing key.
REVOCATION_ASC_ADDRESS=
REVOCATION_REGISTRY_ADDRESS=
REVOCATION_EXPECTED_REVOKER=
REVOCATION_SOURCE_CODE_HASH=
REVOCATION_ASC_CODE_HASH=
REVOCATION_REGISTRY_CODE_HASH=
REVOCATION_POLICY_IDS=1,2
# Read-only local backlog monitor. Positive whole seconds, explicitly approved by the operator.
# No defaults: align screening threshold with the actual rescreen schedule. Review uses RECORD age.
MONITOR_SCREENING_SECONDS=
MONITOR_ISSUANCE_SECONDS=
MONITOR_REVIEW_RECORD_SECONDS=
MONITOR_REVOCATION_SECONDS=
MONITOR_OBSERVATION_SECONDS=
SOURCE_CHAIN_ID=11155111
# API + issuance recovery processor share these server-only settings (see docs/22).
ISSUANCE_JOURNAL_REDIS_REST_URL=
ISSUANCE_JOURNAL_REDIS_REST_TOKEN=
ISSUANCE_JOURNAL_KEY=
ISSUANCE_JOURNAL_NAMESPACE=proofmark
ISSUANCE_CONFIRMATIONS=6
# User-visible tracking targets. Ranges are positive `min-max` seconds; timeout is measured
# from request creation. The support URL must be HTTPS and accept the displayed request ID.
ISSUANCE_SOURCE_EXPECTED_SECONDS=
ISSUANCE_HUB_EXPECTED_SECONDS=
ISSUANCE_TRACKING_TIMEOUT_SECONDS=
ISSUANCE_SUPPORT_URL=
# Required before API/processor signing. Use an independent secret; operator-approved positive
# UTC-day ceilings. Unknown outcomes retain their reservation until receipt reconciliation.
ISSUANCE_GAS_BUDGET_KEY=
ISSUANCE_DAILY_GAS_LIMIT=
ISSUANCE_DAILY_TRANSACTION_LIMIT=
# Optional stable issuer path. Set both, pin the public current generation, and grant the source
# issuer role to ROTATING_ISSUER_ADDRESS only (never the operating EOA).
ROTATING_ISSUER_ADDRESS=
ISSUER_KEY_EPOCH=
COMPLIANCE_OPERATOR_ID=""
EVIDENCE_VAULT_KEY=
# Used only by the explicit local rotate-key procedure; update the runtime secret only through an approved custody workflow.
EVIDENCE_VAULT_NEXT_KEY=
VAULT_KEY_CUSTODIAN_ID=
