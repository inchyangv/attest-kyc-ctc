# ── Development wallet ──
# Testnet only. Never put a mainnet key here.
DEPLOYER_PRIVATE_KEY="0x<64-hex>"
DEPLOYER_ADDRESS="0x..."

# ── Source chain: Ethereum Sepolia (chainKey 1 · chainId 11155111) ──
SOURCE_CHAIN_RPC_URL="https://ethereum-sepolia-rpc.publicnode.com"

# ── Verification hub: Creditcoin CC3 Testnet (chainId 102031) ──
CREDITCOIN_RPC_URL="https://rpc.cc3-testnet.creditcoin.network"
PROOF_BUILDER_URL="https://prover.cc3-testnet.creditcoin.network"
CHAININFO_PRECOMPILE="0x0000000000000000000000000000000000000fd3"
BLOCKPROVER_PRECOMPILE="0x0000000000000000000000000000000000000FD2"

# ── Worker: fill in after deployment (see deployments/cc3-testnet.json) ──
SOURCE_CONTRACT_ADDRESS="0x..."   # Sepolia ComplianceSource
ASC_CONTRACT_ADDRESS="0x..."      # CC3 ProofmarkASC

# ── Worker tuning (defaults are sufficient) ──
WORKER_CONFIRMATIONS=4     # Reorg safety margin in blocks
WORKER_SCAN_CHUNK=500      # Maximum eth_getLogs range
WORKER_POLL_MS=12000
WORKER_CONCURRENCY=8       # Prevent eight-minute attest waits from blocking one another
WORKER_MAX_ATTEMPTS=8
WORKER_STATE_PATH="state/worker.json"
WORKER_START_BLOCK=0       # 0 = start at the current head

# ── Evidence pseudonymization key (required, no default) ──
# Names have low entropy, so unsalted hashes are vulnerable to dictionary attacks. Use an issuer-held HMAC key.
# This is pseudonymization, not anonymization: a key holder can test candidate values, preserving audit reproducibility.
# Generate with: openssl rand -hex 32
EVIDENCE_HMAC_KEY=""
EVIDENCE_KEY_ID="k1"
# Fail closed when the oldest baked OFAC/UN/EU source is older than this. Production should
# refresh and redeploy the index at least daily; the seven-day default is for the public testnet.
SANCTIONS_MAX_AGE_HOURS=168

# Persistent encrypted evidence vault for non-demo issuance. Do not point this at an ephemeral
# serverless filesystem; run the web service on persistent encrypted storage or add a remote vault adapter.
EVIDENCE_VAULT_PATH="state/evidence-vault.enc"
EVIDENCE_RETENTION_DAYS=1825
RESCREEN_INTERVAL_HOURS=24
COMPLIANCE_OPERATOR_ID=""
EVIDENCE_VAULT_KEY=
