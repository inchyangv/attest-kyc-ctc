# ── 개발 지갑 ───────────────────────────────────────────────
# 테스트넷 전용. 메인넷 키를 여기 넣지 말 것.
DEPLOYER_PRIVATE_KEY="0x<64-hex>"
DEPLOYER_ADDRESS="0x..."

# ── 소스 체인: Ethereum Sepolia (chainKey 1 · chainId 11155111) ──
SOURCE_CHAIN_RPC_URL="https://ethereum-sepolia-rpc.publicnode.com"

# ── 검증 허브: Creditcoin CC3 Testnet (chainId 102031) ──────
CREDITCOIN_RPC_URL="https://rpc.cc3-testnet.creditcoin.network"
PROOF_BUILDER_URL="https://prover.cc3-testnet.creditcoin.network"
CHAININFO_PRECOMPILE="0x0000000000000000000000000000000000000fd3"
BLOCKPROVER_PRECOMPILE="0x0000000000000000000000000000000000000FD2"

# ── 워커: 배포 후 채운다 (deployments/cc3-testnet.json 참조) ──
SOURCE_CONTRACT_ADDRESS="0x..."   # Sepolia ComplianceSource
ASC_CONTRACT_ADDRESS="0x..."      # CC3 ProofmarkASC

# ── 워커 튜닝 (기본값으로 충분) ──
WORKER_CONFIRMATIONS=4     # 리오그 여유 블록
WORKER_SCAN_CHUNK=500      # eth_getLogs 범위 상한
WORKER_POLL_MS=12000
WORKER_CONCURRENCY=8       # 어테스트 8분 대기가 서로를 막지 않게
WORKER_MAX_ATTEMPTS=8
WORKER_STATE_PATH="state/worker.json"
WORKER_START_BLOCK=0       # 0 = 현재 헤드부터

# ── 증적 가명화 키 (필수, 기본값 없음) ──
# 이름은 엔트로피가 낮아 무염 해시로는 사전공격에 뚫린다. 발급사 보유 키로 HMAC 한다.
# 가명화이지 익명화가 아니다 — 키 보유자는 후보 대조로 원문 확인이 가능하고, 그게 감사 재현성이다.
# 생성: openssl rand -hex 32
EVIDENCE_HMAC_KEY=""
EVIDENCE_KEY_ID="k1"
