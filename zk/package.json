{
  "name": "proofmark-zk-experimental",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "prove": "node scripts/prove-fixture.mjs",
    "test:circuit": "node scripts/test-negative.mjs",
    "test:solidity": "node scripts/test-solidity.mjs",
    "verify": "snarkjs groth16 verify build/verification_key.json build/public.json build/proof.json",
    "test": "npm run build && npm run prove && npm run verify && npm run test:circuit && npm run test:solidity"
  },
  "dependencies": {
    "circom2": "0.2.23",
    "circomlib": "2.0.5",
    "circomlibjs": "0.1.7",
    "snarkjs": "0.7.6"
  },
  "overrides": {
    "underscore": "1.13.8",
    "ws": "8.21.3"
  }
}
