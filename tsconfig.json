{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "aml/**/*.ts",
    "worker/**/*.ts",
    "script/**/*.ts",
    "pipeline/**/*.ts",
    "examples/**/*.ts",
    "test/cross-chain-gate.integration.ts",
    "test/sumsub-redis.integration.ts",
    "test/worker-crash.integration.ts",
    "test/epoch-publication.integration.ts",
    "test/epoch-publish-cli.integration.ts",
    "test/vault-recovery.integration.ts",
    "test/fixtures/epoch-publication-crash.ts"
  ]
}
